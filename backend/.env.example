# Copy this file to ".env" and change the values.
# NEVER commit the real .env file to GitHub.

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite for development. Later: a PostgreSQL URL, e.g.
#   postgresql+psycopg://user:password@localhost:5432/elysian
DATABASE_URL=sqlite:///./elysian.db

# Frontend addresses allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login token lifetime in minutes (default 8 hours)
ACCESS_TOKEN_MINUTES=480
